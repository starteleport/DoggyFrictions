{
  "name": "doggyfrictions-e2e",
  "private": true,
  "description": "Playwright regression tests for DoggyFrictions",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed --workers=1",
    "test:compose": "docker compose -f ../../docker-compose.ui-tests.yml up --build --abort-on-container-exit --exit-code-from ui-tests",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "^22.0.0"
  }
}
