<div class="page-head page-head-split">
    <div class="col-lg-4">
        @await Html.PartialAsync("NavigationBar")
    </div>
    <h2 class="col col-lg-8 form-inline">
        <!-- ko if: $root.IsEdit() -->
        <span class="input-group">
            <span class="input-group-text"><span class="bi bi-tag"></span></span>
            <input data-testid="session-name-input" type="text" class="form-control" data-bind="value: Name" placeholder="@T["session.namePlaceholder"]">
        </span>
        <!-- /ko -->
        <!-- ko if: !$root.IsEdit() -->
        <span data-testid="session-title" data-bind="text: (Name() || '')"></span>
        <!-- /ko -->
        <!-- ko if: !$root.IsEdit() -->
        <a class="btn btn-primary" data-bind="attr: {href: '#/Session/Edit/' + Id}"><span class="bi bi-pencil"></span></a><a data-testid="delete-session-button" class="btn btn-primary" data-bind="ifConfirmed: Delete,
                                    cdTitle: T('sessions.deleteTitle'), cdMessage: T('sessions.deleteMessage', Name())"><span class="bi bi-trash"></span></a>
        <!-- /ko -->
    </h2>
</div>
