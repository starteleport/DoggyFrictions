<div class="page-head page-head-split">
    <ul class="breadcrumb breadcrumb-default col-lg-4">
        <li class="breadcrumb-item"><a data-bind="attr: {href: '#/Sessions'}">@T["sessions.title"]</a></li>
        <li class="breadcrumb-item"><a data-bind="attr: {href: '#/Session/' + Session.Id}">@T["session.title"]</a></li>
        <li class="breadcrumb-item active">@T["debts.title"]</li>
    </ul>
    <h2 class="col col-lg-8 form-inline">
        <span data-bind="text: Session.Name || ''"></span>
    </h2>
</div>