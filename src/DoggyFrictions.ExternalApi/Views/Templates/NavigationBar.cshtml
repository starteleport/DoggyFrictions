<ul class="breadcrumb breadcrumb-default" data-bind="with: Navigation">
    <!-- ko foreach: History -->
    <li class="breadcrumb-item">
        <!-- ko if: $root.IsEdit() -->
        <a data-bind="ifConfirmed: window.App.Functions.Move(Url),
               cdTitle: T('common.discardTitle'), cdMessage: T('common.discardMessage'),
               text: Name"></a>
        <!-- /ko -->
        <!-- ko ifnot: $root.IsEdit() -->
        <a data-bind="attr: {href: Url}, text: Name"></a>
        <!-- /ko -->
    </li>
    <!-- /ko -->
    <li class="breadcrumb-item active" data-bind="text: CurrentPlace"></li>
</ul>