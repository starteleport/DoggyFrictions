<script type="text/html" id="debts-template">
    <div data-testid="debts-view" class="debts jumbotron is-preview">
        <div>
            @await Html.PartialAsync("DebtsHeader")
            <h4>@T["debts.balances"]</h4>
            <!-- ko if: Balances.length -->
            <div class="debt-balances-block" data-bind="foreach: Balances">
                <span data-testid="balance-row" class="balance-span" data-bind="if: Balance">
                    <span data-bind="text: Name + ': '"></span>
                    <span data-testid="balance-amount" data-bind="text: Balance.formatMoney(), css:{'text-danger':Balance < 0, 'text-success':Balance > 0}"></span>
                </span>
            </div>
            <!-- /ko -->
            <span data-testid="balances-empty" data-bind="if: !Balances.length">@T["debts.settled"]</span>
            <h4>@T["debts.list"]</h4>
            <!-- ko if: Debts.length -->
            <table class="debts-table">
                <tbody data-bind="foreach: Debts">
                <tr data-testid="debt-row" class="debt-block">
                    <td data-testid="debt-debtor" class="wide-cell" data-bind="text: Debtor"></td>
                    <td class="money-cell">
                        <span data-testid="debt-amount" class="" data-bind="text: Amount.formatMoney()"></span>
                        <i class="bi bi-arrow-right text-success"></i>
                    </td>
                    <td data-testid="debt-creditor" class="wide-cell text-end" data-bind="text: Creditor"></td>
                    <td class="actions-cell">
                        <a data-testid="debt-payoff-button" class="btn btn-sm btn-primary" data-bind="ifConfirmed: $parent.PayOff,
                           cdTitle: T('debts.payOffTitle'), cdMessage: T('debts.payOffMessage', Creditor, Debtor)">@T["debts.payOff"]</a>
                    </td>
                </tr>
                </tbody>
            </table>
            <!-- /ko -->
            <span data-testid="debts-empty" data-bind="if: !Debts.length">@T["debts.settled"]</span>
        </div>
    </div>
</script>
