<script type="text/html" id="action-template">
    <div data-testid="action-view" class="action" data-bind="css: {'is-edit': $root.IsEdit(), 'is-preview': !$root.IsEdit()}">
        <div class="">
            <div class="jumbotron">
                <div>
                    <div>
                        @await Html.PartialAsync("ActionHeader")
                        <h4>@T["action.itemsTitle"]</h4>
                        <div>
                            <div class="sticky-table-head">
                                <div class="wide-cell">@T["action.item"]</div>
                                <div class="money-cell">@T["common.amount"]</div>
                                <div class="money-cell">@T["action.quantityShort"]</div>
                                <!-- ko foreach: Session.Participants -->
                                <div class="money-cell" data-bind="text: Name()"></div>
                                <!-- /ko -->
                            </div>
                            <span data-bind="if: !Consumptions().length">@T["common.noData"]</span>
                            <table data-testid="consumptions-table" class="table table-cards" data-bind="executeOnEnter: AddConsumption">
                                <thead data-bind="if: Consumptions().length">
                                <tr>
                                    <th class="wide-cell">@T["action.item"]</th>
                                    <th class="money-cell">@T["common.amount"]</th>
                                    <th class="small-cell">@T["action.quantityShort"]</th>
                                    <!-- ko foreach: Session.Participants -->
                                    <!-- ko if: $root.IsEdit() -->
                                    <th class="money-cell consumer-header" data-bind="text: Name(), click: $parent.ToggleConsumer"></th>
                                    <!-- /ko -->
                                    <!-- ko if: !$root.IsEdit() -->
                                    <th class="money-cell" data-bind="text: Name()"></th>
                                    <!-- /ko -->
                                    <!-- /ko -->
                                    <th class="delete-row-cell actions-cell"></th>
                                </tr>
                                </thead>
                                <tbody>
                                <!-- ko foreach: Consumptions -->
                                <tr data-testid="consumption-row" class="card-row">
                                    <td class="wide-cell" data-label="@T["action.item"]">
                                        <!-- ko if: $root.IsEdit() -->
                                        <div class="form-group">
                                            <input data-testid="consumption-description-input" type="text" class="form-control" data-bind="value: Description, attr: {tabindex: window.App.GlobalId.Next() + 10}, hasFocus: HasFocus" placeholder="@T["action.itemPlaceholder"]"/>
                                        </div>
                                        <!-- /ko -->
                                        <!-- ko if: !$root.IsEdit() -->
                                        <span data-bind="text: Description()"></span>
                                        <!-- /ko -->
                                    </td>
                                    <td class="money-cell" data-label="@T["action.price"]">
                                        <!-- ko if: $root.IsEdit() -->
                                        <div class="form-group">
                                            <input data-testid="consumption-amount-input" type="text" inputmode="decimal" class="form-control" data-bind="money: Amount, attr: {tabindex: window.App.GlobalId.Next() + 10}" placeholder="@T["common.amount"]">
                                        </div>
                                        <!-- /ko -->
                                        <!-- ko if: !$root.IsEdit() -->
                                        <span data-bind="text: Amount().formatMoney()"></span>
                                        <!-- /ko -->
                                    </td>
                                    <td class="small-cell" data-label="@T["action.quantity"]">
                                        <!-- ko if: $root.IsEdit() -->
                                        <div class="form-group">
                                            <input data-testid="consumption-quantity-input" type="text" inputmode="decimal" class="form-control" data-bind="money: Quantity, attr: {tabindex: window.App.GlobalId.Next() + 10}" placeholder="@T["action.quantity"]">
                                        </div>
                                        <!-- /ko -->
                                        <!-- ko if: !$root.IsEdit() -->
                                        <span data-bind="text: Quantity"></span>
                                        <!-- /ko -->
                                    </td>
                                    <!-- ko foreach: Consumers -->
                                    <td class="money-cell consumer-cell" data-bind="attr: {'data-label': ParticipantName}, css: {'card-hide': !$root.IsEdit() && !IsActive()}">
                                        <!-- ko if: $root.IsEdit() -->
                                        <div class="form-group">
                                            <div class="input-group">
                                                <span class="input-group-text">
                                                        <span class="checkbox">
                                                            <label><input data-testid="consumer-checkbox" type="checkbox" data-bind="checked: IsActive" tabindex="-1" /></label>
                                                        </span>
                                                    </span><!-- ko if: $parent.IsAuto() || !IsActive() -->
                                                <span data-testid="consumer-share" class="form-control form-control-highlight" data-bind="text: Amount().formatMoney()" disabled></span>
                                                <!-- /ko -->
                                                <!-- ko if: !$parent.IsAuto() && IsActive() -->
                                                <input type="text" inputmode="decimal" class="form-control" data-bind="money: Amount" tabindex="-1" placeholder="@T["action.share"]">
                                                <!-- /ko -->
                                            </div>
                                        </div>
                                        <!-- /ko -->
                                        <!-- ko if: !$root.IsEdit() && IsActive() -->
                                        <span data-bind="text: Amount().formatMoney()"></span>
                                        <!-- /ko -->
                                    </td>
                                    <!-- /ko -->
                                    <!-- ko if: $root.IsEdit() -->
                                    <td class="actions-cell"><button type="button" class="btn btn-primary" data-bind="click: $parent.DeleteConsumption"><span class="bi bi-trash"></span></button></td>
                                    <!-- /ko -->
                                </tr>
                                <!-- /ko -->
                                <!-- ko if: $root.IsEdit() -->
                                <tr>
                                    <td class="actions-cell">
                                        <button data-testid="add-consumption-button" type="button" class="btn btn-primary" data-bind="click: AddConsumption">
                                            <span><span class="bi bi-plus"></span> @T["common.add"]</span>
                                        </button>
                                    </td>
                                </tr>
                                <!-- /ko -->
                                </tbody>
                                <tfoot data-testid="consumptions-total" data-bind="if: Consumptions().length">
                                <tr class="card-row">
                                    <td class="wide-cell card-title">@T["action.total"]</td>
                                    <td class="money-cell" data-label="@T["action.grandTotal"]"><span data-bind="text: Amount().formatMoney()"></span></td>
                                    <td class="small-cell card-hide"></td>
                                    <!-- ko foreach: ConsumerTotals -->
                                    <td class="money-cell" data-bind="attr: {'data-label': Name}"><span data-bind="text: Total.formatMoney()"></span></td>
                                    <!-- /ko -->
                                    <!-- ko if: $root.IsEdit() -->
                                    <td class="actions-cell"></td>
                                    <!-- /ko -->
                                </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>

                    <div class="">
                        <h4>@T["action.payersTitle"]</h4>
                        <span data-bind="if: !Payers().length">@T["common.noData"]</span>
                        <table data-testid="payers-table" class="table table-cards">
                            <thead data-bind="if: Payers().length">
                            <tr>
                                <th class="wide-cell">@T["action.payerName"]</th>
                                <th class="money-cell">@T["common.amount"]</th>
                                <th class="actions-cell"></th>
                            </tr>
                            </thead>
                            <tbody>
                            <!-- ko foreach: Payers -->
                            <tr data-testid="payer-row" class="card-row">
                                <td class="wide-cell" data-label="@T["action.payer"]">
                                    <!-- ko if: $root.IsEdit() -->
                                    <div>
                                        <select data-testid="payer-select" class="form-control" data-bind="options: $parent.Session.Participants,
                                                optionsText: 'Name', optionsValue: 'Id', value: ParticipantId, attr: {tabindex: window.App.GlobalId.Next() + 1000}"></select>
                                    </div>
                                    <!-- /ko -->
                                    <!-- ko if: !$root.IsEdit() -->
                                    <span data-bind="text: $parent.Session.GetParticipant(ParticipantId()).Name()"></span>
                                    <!-- /ko -->
                                </td>
                                <td class="money-cell" data-label="@T["common.amount"]">
                                    <!-- ko if: $root.IsEdit() -->
                                    <input data-testid="payer-amount-input" type="text" inputmode="decimal" class="form-control" data-bind="money: Amount, attr: {tabindex: window.App.GlobalId.Next() + 1000}" placeholder="@T["common.amount"]">
                                    <!-- /ko -->
                                    <!-- ko if: !$root.IsEdit() -->
                                    <span data-bind="text: Amount().formatMoney()"></span>
                                    <!-- /ko -->
                                </td>
                                <!-- ko if: $root.IsEdit() -->
                                <td class="actions-cell"><button type="button" class="btn btn-primary" data-bind="click: $parent.DeletePayer"><span class="bi bi-trash"></span></button></td>
                                <!-- /ko -->
                            </tr>
                            <!-- /ko -->
                            <!-- ko if: $root.IsEdit() -->
                            <tr>
                                <td class="actions-cell">
                                    <button data-testid="add-payer-button" type="button" class="btn btn-primary" data-bind="click: AddPayer">
                                        <span><span class="bi bi-plus"></span> @T["common.add"]</span>
                                    </button>
                                </td>
                            </tr>
                            <!-- /ko -->
                            </tbody>
                        </table>
                    </div>
                    <div class="">
                        <!-- ko if: $root.IsEdit() -->
                        <div class="form-group">
                            <button data-testid="save-action-button" type="button" class="btn btn-primary btn-raised" data-bind="click: Save">
                                <span class="bi bi-floppy"></span> @T["action.save"]
                            </button>
                            <!-- ko if: !$root.Id -->
                            <button type="button" class="btn btn-primary btn-raised" data-bind="click: SaveAndNew">
                                <span class="bi bi-floppy"></span> @T["action.saveAndNew"]
                            </button>
                            <!-- /ko -->
                            <button type="button" class="btn btn-primary" data-bind="ifConfirmed: window.App.Functions.Move(Navigation.Back().Url),
                                cdTitle: T('common.discardTitle'), cdMessage: T('common.discardMessage') ">
                                @T["common.cancel"]
                            </button>
                        </div>
                        <!-- /ko -->
                    </div>
                </div>
            </div>
        </div>
    </div>
</script>
