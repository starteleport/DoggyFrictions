<script type="text/html" id="session-edit-template">
    <div data-testid="session-edit-view" class="session jumbotron" data-bind="css: {'is-edit': $root.IsEdit(), 'is-preview': !$root.IsEdit()}">
        <div>
            @await Html.PartialAsync("SessionHeader")

            <h4>@T["session.participantsTitle"]</h4>
            <span data-bind="if: !Participants().length">@T["session.noParticipants"]</span>
            <table class="table table-cards">
                <thead data-bind="if: Participants().length">
                <tr>
                    <th class="wide-cell">@T["session.participantName"]</th>
                    <th class="actions-cell"></th>
                </tr>
                </thead>
                <tbody>
                <!-- ko foreach: Participants-->
                <tr class="card-row">
                    <td class="wide-cell" data-label="@T["session.participantName"]">
                        <input data-testid="participant-name-input" type="text" class="form-control" data-bind="value: Name" placeholder="@T["session.participantPlaceholder"]">
                    </td>
                    <td class="actions-cell"><button type="button" class="btn btn-primary" data-bind="click: $parent.DeleteParticipant"><span class="bi bi-trash"></span></button></td>
                </tr>
                <!-- /ko -->
                <tr>
                    <td class="actions-cell">
                        <button data-testid="add-participant-button" type="button" class="btn btn-primary" data-bind="click: AddParticipant">
                            <span><span class="bi bi-plus"></span> @T["common.add"]</span>
                        </button>
                    </td>
                </tr>
                </tbody>
            </table>
            <button data-testid="save-session-button" type="submit" class="btn btn-primary btn-raised" data-bind="click: Save"><span class="bi bi-floppy"></span> @T["session.save"]</button>
            <button type="button" class="btn btn-primary" data-bind="ifConfirmed: window.App.Functions.Move(Navigation.Back().Url),
                cdTitle: T('common.discardTitle'), cdMessage: T('common.discardMessage') ">
                @T["common.cancel"]
            </button>
        </div>
    </div>
</script>
