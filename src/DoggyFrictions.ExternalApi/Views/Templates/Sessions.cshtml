<script type="text/html" id="sessions-template">
    <div data-testid="sessions-view" class="sessions jumbotron is-preview">
        <div>
            <div class="page-head">
                <h2 class="text-center">@T["sessions.home"]</h2>
            </div>
            <h4>@T["sessions.listTitle"]</h4>
            <table class="table table-clickable table-cards">
                <thead>
                    <tr>
                        <th class="really-wide-cell">@T["common.name"]</th>
                        <th class="really-wide-cell">@T["sessions.participants"]</th>
                        <th class="actions-cell"></th>
                    </tr>
                </thead>
                <tbody data-bind="foreach: Sessions">
                    <tr data-testid="session-row" class="card-row">
                        <td data-testid="session-name-cell" class="really-wide-cell" data-label="@T["common.name"]" data-bind="text: Name, click: window.App.Functions.Move('#/Session/' + Id)"></td>
                        <td class="really-wide-cell" data-label="@T["sessions.participants"]" data-bind="text: ParticipantNames(), click: window.App.Functions.Move('#/Session/' + Id)"></td>
                        <td class="actions-cell">
                            <a class="btn btn-primary" data-bind="attr: {href: '#/Session/' + Id + '/Debts'}"><span class="bi bi-arrow-left-right"></span></a><a class="btn btn-primary" data-bind="attr: {href: '#/Session/Edit/' + Id}"><span class="bi bi-pencil"></span></a><a data-testid="delete-session-button" class="btn btn-primary" data-bind="ifConfirmed: Delete,
                                    cdTitle: T('sessions.deleteTitle'), cdMessage: T('sessions.deleteMessage', Name())"><span class="bi bi-trash"></span></a>
                        </td>
                    </tr>
                </tbody>
            </table>
            <a data-testid="create-session-button" class="btn btn-primary btn-raised" data-bind="attr: {href: '#/Session/Create'}"><span class="bi bi-plus"></span> @T["sessions.create"]</a>
        </div>
    </div>
</script>
