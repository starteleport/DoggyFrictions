<script type="text/html" id="confirm-dialog-template">
    <div data-testid="confirm-dialog" class="modal fade confirm-dialog" tabindex="-1" role="dialog">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h4 data-testid="confirm-dialog-title" class="modal-title" data-bind="text: Title, click: alert"></h4>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <span data-testid="confirm-dialog-message" data-bind="text: Message"></span>
                </div>
                <div class="modal-footer">
                    <button data-testid="confirm-dialog-yes" type="submit" class="btn btn-primary btn-raised" data-bs-dismiss="modal" data-bind="click: Submit">@T["common.yes"]</button>
                    <button data-testid="confirm-dialog-no" type="button" class="btn btn-primary" data-bs-dismiss="modal">@T["common.no"]</button>
                </div>
            </div>
        </div>
    </div>
</script>