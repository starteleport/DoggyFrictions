<script type="text/html" id="session-template">
    <div data-testid="session-view" class="session jumbotron" data-bind="css: {'is-edit': $root.IsEdit(), 'is-preview': !$root.IsEdit()}">
        <div>
            @await Html.PartialAsync("SessionHeader")

            <h4>@T["session.participantsTitle"]</h4>
            <div data-bind="if: !Participants().length">@T["session.noParticipants"]</div>
            <!-- ko if: Participants().length -->
            <div data-testid="session-participants-summary" data-bind="text: _.reduce(Participants(), function(memo, p) { return (memo.Name ? memo.Name() : memo) + ', ' + p.Name() })"></div>
            <!-- /ko -->

            <a data-testid="create-action-button" class="btn btn-primary" data-bind="attr: {href: '#/Session/' + Id + '/Action/Create'}"><span class="bi bi-plus"></span> @T["session.addAction"]</a>
            <a data-testid="session-debts-button" class="btn btn-primary" data-bind="attr: {href: '#/Session/' + Id + '/Debts'}"><span class="bi bi-arrow-left-right"></span> @T["session.debts"]</a>

            <div class="clearfix">
                <h4 class="float-start">@T["session.actionsTitle"]</h4>
                <div class="col-lg-1 float-end"></div>
                <!-- ko if: !Actions.IsLoading() -->
                <span class="float-end" data-bind="with: Actions">
                    @await Html.PartialAsync("Pages")
                </span>
                <!-- /ko -->
            </div>
            <div class="loading-screen-small" data-bind="if: Actions.IsLoading()">
                <img src='@Url.Content("../../img/runningdog_transparent.gif")' alt="@T["common.loading"]">
            </div>
            <!-- ko if: !Actions.IsLoading() -->
            <div data-bind="with: Actions">
                <span data-testid="actions-empty" data-bind="if: !Rows().length">@T["session.noActions"]</span>
                <table class="table table-clickable table-cards" data-bind="if: Rows().length">
                    <thead>
                        <tr>
                            <th class="small-cell">@T["common.date"]</th>
                            <th class="really-wide-cell">@T["session.actionDescription"]</th>
                            <th class="wide-cell">@T["session.actionPayers"]</th>
                            <th class="money-cell">@T["common.amount"]</th>
                            <th class="actions-cell"></th>
                        </tr>
                    </thead>
                    <tbody data-bind="foreach: Rows">
                        <tr data-testid="session-action-row" class="card-row">
                            <td class="small-cell" data-label="@T["common.date"]" data-bind="text: Date().formatDate(),click: window.App.Functions.Move('#/Session/' + Session.Id + '/Action/' + Id)"></td>
                            <td class="really-wide-cell" data-label="@T["session.actionDescription"]" data-bind="text: Description(),click: window.App.Functions.Move('#/Session/' + Session.Id + '/Action/' + Id)"></td>
                            <td class="wide-cell" data-label="@T["session.actionPayers"]" data-bind="text: PayerNames(),click: window.App.Functions.Move('#/Session/' + Session.Id + '/Action/' + Id)"></td>
                            <td class="money-cell" data-label="@T["common.amount"]" data-bind="text: Amount().formatMoney(),click: window.App.Functions.Move('#/Session/' + Session.Id + '/Action/' + Id)"></td>
                            <td class="actions-cell">
                                <a class="btn btn-primary" data-bind="attr: {href: '#/Session/' + Session.Id + '/Action/Edit/' + Id}"><span class="bi bi-pencil"></span></a><a data-testid="delete-action-button" class="btn btn-primary" data-bind="ifConfirmed: Delete,
                                    cdTitle: T('action.deleteTitle'), cdMessage: T('action.deleteMessage', Description())"><span class="bi bi-trash"></span></a></td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <!-- /ko -->
        </div>
    </div>
</script>
