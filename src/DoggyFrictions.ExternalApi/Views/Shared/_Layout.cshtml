@{
    ViewData["Title"] = "Doggy Frictions";
}
<!DOCTYPE html>
<html lang="@T.Culture">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <link rel="shortcut icon" type="image/x-icon" href="@Url.Content("~/img/imageedit_6_8030490022.png")" />
    <!-- Installable web app (PWA) -->
    <link rel="manifest" href="~/manifest.webmanifest" />
    <meta name="theme-color" content="#009688" />
    <link rel="apple-touch-icon" href="~/img/apple-touch-icon.png" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Frictions" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap" crossorigin="anonymous" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          asp-fallback-href="~/lib/bootstrap/dist/css/bootstrap.min.css"
          asp-fallback-test-class="visually-hidden"
          asp-fallback-test-property="position"
          asp-fallback-test-value="absolute"
          integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
          crossorigin="anonymous"
          referrerpolicy="no-referrer" />

    <!-- Served locally: bootstrap-icons styles only ::before, so a CDN fallback test cannot detect it -->
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" asp-append-version="true" />

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-datepicker/1.9.0/css/bootstrap-datepicker3.min.css"
          asp-fallback-href="~/lib/bootstrap-datepicker/dist/css/bootstrap-datepicker3.min.css"
          asp-fallback-test-class="datepicker"
          asp-fallback-test-property="border-radius"
          asp-fallback-test-value="4px"
          integrity="sha512-rxThY3LYIfYsVCWPCW9dB0k+e3RZB39f23ylUYTEuZMDrN/vRqLdaCBo/FbvVT6uC2r0ObfPzotsfKF9Qc5W5g=="
          crossorigin="anonymous"
          referrerpolicy="no-referrer" />

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/snackbarjs/1.1.0/snackbar.min.css"
          asp-fallback-href="~/lib/snackbarjs/dist/snackbar.min.css"
          asp-fallback-test-class="datepicker"
          asp-fallback-test-property="border-radius"
          asp-fallback-test-value="4px"
          integrity="sha512-ZubYj+rC7zgkWTuAVwkm17rin+FmWcEgDhM3xG1WSDDPFF756pTSVqZ0/cPhIZkLUHwcMRvNUv2OreI1kww5yg=="
          crossorigin="anonymous"
          referrerpolicy="no-referrer" />
    <environment names="Development">
        <link rel="stylesheet" href="~/css/site.css" />
    </environment>
    <environment names="Staging,Production">
        <link rel="stylesheet" href="~/css/min/site.min.css" asp-append-version="true" />
    </environment>
    <title>@ViewData["Title"]</title>
</head>
<body>
<nav class="navbar navbar-dark bg-dark fixed-top">
    <div class="container-fluid">
        <a class="navbar-brand" href="#/Sessions"><img src="~/img/imageedit_6_8030490022.png"/>Doggy Frictions</a>
        <div class="dropdown settings-menu">
            <button data-testid="settings-button" type="button" class="btn btn-sm btn-outline-light dropdown-toggle"
                    data-bs-toggle="dropdown" aria-expanded="false" aria-label="@T["settings.title"]">
                <span class="bi bi-gear"></span> <span class="d-none d-sm-inline">@T["settings.title"]</span>
            </button>
            <ul class="dropdown-menu dropdown-menu-end">
                <li><h6 class="dropdown-header">@T["settings.language"]</h6></li>
                @foreach (var language in TextCatalog.Languages)
                {
                    <li>
                        <button data-testid="language-@language.Code" data-language="@language.Code" type="button"
                                class="dropdown-item @(language.Code == T.Language ? "active" : null)">@language.Name</button>
                    </li>
                }
            </ul>
        </div>
    </div>
</nav>
<div class="body-content">
    @RenderBody()
    <hr/>
    <footer>
        <p>&copy; @DateTime.Now.Year - Doggy Inc</p>
    </footer>
</div>
<!-- snackbarjs creates this itself as "<div id=snackbar-container/>", which jQuery 3.5+ parses
     with the slash inside the id, so its toasts were never attached. Provide it up front. -->
<div id="snackbar-container"></div>

<!-- Interface texts in the language of this request, for the scripts (see js/i18n.js). -->
<script>
    window.AppLanguage = '@T.Language';
    window.AppCulture = '@T.Culture';
    window.AppTexts = @Json.Serialize(T.All);
</script>

<script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"
        asp-fallback-src="~/lib/jquery/dist/jquery.min.js"
        asp-fallback-test="window.jQuery"
        integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo="
        crossorigin="anonymous"
        referrerpolicy="no-referrer">
    </script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-dateFormat/1.0/jquery.dateFormat.min.js"
        asp-fallback-src="~/lib/jquery-dateformat/dist/jquery-dateformat.min.js"
        asp-fallback-test="window.jQuery && window.jQuery.format"
        crossorigin="anonymous">
    </script>
<!-- node_modules does not have minified Modernizr, integrity check will break on fallback -->
<!-- TODO: minify ourselves-->
<script src="https://cdnjs.cloudflare.com/ajax/libs/modernizr/2.8.3/modernizr.min.js"
        asp-fallback-src="~/lib/npm-modernizr/modernizr.min.js"
        asp-fallback-test="window.Modernizr"
        crossorigin="anonymous"
        referrerpolicy="no-referrer">
    </script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
        asp-fallback-src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"
        asp-fallback-test="window.bootstrap"
        integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
        crossorigin="anonymous"
        referrerpolicy="no-referrer">
    </script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/knockout/3.5.3/knockout-latest.js"
        asp-fallback-src="~/lib/knockout/build/output/knockout-latest.js"
        asp-fallback-test="window.ko"
        integrity="sha512-RZ5HPKjxokd5E5Vz9x4eVmWyJihWo0aQUS+jWrPFtgHxI32/k+hn7yKM/HdGULg+ZO/ooHlM15/We9Gje7RofQ=="
        crossorigin="anonymous"
        referrerpolicy="no-referrer">
    </script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/knockout-validation/2.0.4/knockout.validation.min.js"
        asp-fallback-src="~/lib/knockout.validation/dist/knockout.validation.min.js"
        asp-fallback-test="window.ko && window.ko.validation"
        integrity="sha512-b99MDNv5TqiZtPKH2UeHzDAVydmgrOJEPtaPPEF8AgV86eYyqINFI/K7/7f0+R4WNTAVv8KvvpjwfOYHv5rd5g=="
        crossorigin="anonymous"
        referrerpolicy="no-referrer">
    </script>
<!-- node_modules does not have minified moment.js, integrity check will break on fallback -->
<!-- TODO: minify ourselves-->
<script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.29.3/moment.min.js"
        asp-fallback-src="~/lib/moment/min/moment.min.js"
        asp-fallback-test="window.Moment"
        crossorigin="anonymous">
    </script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-datepicker/1.9.0/js/bootstrap-datepicker.min.js"
        asp-fallback-src="~/lib/bootstrap-datepicker/dist/js/bootstrap-datepicker.min.js"
        asp-fallback-test="window.jQuery && window.jQuery.fn && window.jQuery.fn.datepicker"
        integrity="sha512-T/tUfKSV1bihCnd+MxKD0Hm1uBBroVYBOYSk1knyvQ9VyZJpc/ALb4P0r6ubwVPSGB2GvjeoMAJJImBG12TiaQ=="
        crossorigin="anonymous"
        referrerpolicy="no-referrer">
    </script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-datepicker/1.9.0/locales/bootstrap-datepicker.ru.min.js"
        asp-fallback-src="~/lib/bootstrap-datepicker/dist/locales/bootstrap-datepicker.ru.min.js"
        asp-fallback-test="window.jQuery && window.jQuery.fn && window.jQuery.fn.datepicker"
        integrity="sha512-tPXUMumrKam4J6sFLWF/06wvl+Qyn27gMfmynldU730ZwqYkhT2dFUmttn2PuVoVRgzvzDicZ/KgOhWD+KAYQQ=="
        crossorigin="anonymous"
        referrerpolicy="no-referrer">
    </script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/snackbarjs/1.1.0/snackbar.min.js"
        asp-fallback-src="~/lib/snackbarjs/dist/snackbar.min.js"
        asp-fallback-test="window.jQuery && window.jQuery.snackbar"
        integrity="sha512-Knad2JJvcddGNKm03ySDgeTKXQfBjH0XPrFqUyzM0BuJhKkVfLzoOK5Ii9jsLmbZTXM8YNqn42suHyIEbQXboQ=="
        crossorigin="anonymous"
        referrerpolicy="no-referrer">
    </script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/sammy.js/0.7.6/sammy.min.js"
        asp-fallback-src="~/lib/sammy/lib/min/sammy-latest.min.js"
        asp-fallback-test="window.jQuery && window.jQuery.sammy"
        integrity="sha512-P0qL6322HXDfrw8EsI8yQVGGc1+SSAZm5AWOYjPTrlZDQLX229heMa1XTOloWwynwxwWh2ElN3/GNoG1wT5r8Q=="
        crossorigin="anonymous"
        referrerpolicy="no-referrer">
    </script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/underscore.js/1.13.6/underscore-min.js"
        asp-fallback-src="~/lib/underscore/underscore-min.js"
        asp-fallback-test="window._"
        integrity="sha512-2V49R8ndaagCOnwmj8QnbT1Gz/rie17UouD9Re5WxbzRVUGoftCu5IuqqtAM9+UC3fwfHCSJR1hkzNQh/2wdtg=="
        crossorigin="anonymous"
        referrerpolicy="no-referrer">
    </script>
<!-- node_modules does not have minified jquery.sticky, integrity check will break on fallback -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery.sticky/1.0.4/jquery.sticky.min.js"
        asp-fallback-src="~/lib/jquery-sticky/jquery.sticky.min.js"
        asp-fallback-test="window.jQuery && window.jQuery.fn && window.jQuery.fn.sticky"
        crossorigin="anonymous">
    </script>
<environment names="Development">
    <script src="~/js/i18n.js"></script>
    <script src="~/js/util.js"></script>
    <script src="~/js/ko-extensions.js"></script>
    <script src="~/js/sticky-header.js"></script>
    <script src="~/js/pagedGridModel.js"></script>
    <script src="~/js/start.js"></script>
    <script src="~/js/action.js"></script>
    <script src="~/js/consumption.js"></script>
    <script src="~/js/debt.js"></script>
    <script src="~/js/navigation.js"></script>
    <script src="~/js/session.js"></script>
    <script src="~/js/pwa.js"></script>
</environment>
<environment names="Staging,Production">
    <script src="~/js/min/site.min.js" asp-append-version="true"></script>
</environment>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
